# Crop Nexus — Frontend Environment Variables
# Spring Boot API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Development Mode (keep false for production)
VITE_ENABLE_DEMO_MODE=false

# Max file upload size in bytes (10MB default)
VITE_MAX_UPLOAD_BYTES=10485760

# Default UI language (mr = Marathi, en = English)
VITE_DEFAULT_LANGUAGE=mr
