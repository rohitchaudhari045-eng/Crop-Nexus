# Crop Nexus — Frontend Environment Variables
# Backend Flask API Base URL (Change to your Flask backend address, e.g., http://localhost:5000/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Enable Mock / Demo data mode (true enables rich client-side demo state without requiring backend)
VITE_ENABLE_DEMO_MODE=true

# Optional: Weather API Key or proxy
VITE_WEATHER_API_KEY=
